APP_PORT=3000

# Neon "dev" branch: used by pnpm dev, pnpm migrate and pnpm seed.
# For production, put the "main" branch URL in .env.production.local
# (git-ignored); pnpm migrate:prod and pnpm seed:prod read that file.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require
